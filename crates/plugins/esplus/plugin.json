{
  "id": "esplus",
  "name": "ESPlus 适配",
  "version": "0.1.0",
  "description": "扫描 NeoForge 实例的 ESPlus 模组与面板配置；可写入 loopback 面板密码、从 GitHub Releases 安装 jar。",
  "permissions": [
    "http.expose",
    "controlplane.instances.read",
    "controlplane.files.read",
    "controlplane.files.write",
    "net.fetch",
    "ui.contribute"
  ],
  "ui": {
    "label": "ESPlus",
    "icon": "fa-shield",
    "nav": true,
    "path": "/summary",
    "views": [
      {
        "id": "fleet",
        "type": "table",
        "title": "实例",
        "path": "/summary",
        "rows": "instances",
        "columns": [
          { "key": "name", "label": "实例" },
          { "key": "status", "label": "状态" },
          { "key": "jar", "label": "模组" },
          { "key": "panelUrl", "label": "面板" }
        ],
        "rowActions": [
          { "label": "写入配置", "path": "/ensure-config", "method": "POST", "bodyKey": "instanceId" },
          { "label": "安装模组", "path": "/install", "method": "POST", "bodyKey": "instanceId", "primary": true }
        ]
      }
    ]
  }
}

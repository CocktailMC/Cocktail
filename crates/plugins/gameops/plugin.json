{
  "id": "gameops",
  "name": "GameOps 资源控制",
  "version": "0.1.0",
  "description": "声明式 World / PluginSet / Proxy / Network；Node 与 Instance 从控制面观察并协调。",
  "tick_ms": 20000,
  "permissions": [
    "http.expose",
    "scheduler",
    "events.subscribe",
    "controlplane.instances.read",
    "controlplane.instances.write",
    "controlplane.nodes.read",
    "controlplane.files.write",
    "ui.contribute"
  ],
  "ui": {
    "label": "GameOps",
    "icon": "fa-cubes",
    "nav": true,
    "path": "/summary",
    "views": [
      {
        "id": "manifest",
        "type": "code",
        "title": "清单",
        "path": "/example",
        "language": "yaml",
        "submit": { "path": "/apply", "method": "POST", "bodyKey": "yaml", "label": "Apply 清单" }
      },
      {
        "id": "actions",
        "type": "actions",
        "actions": [{ "label": "立即协调", "path": "/reconcile", "method": "POST" }]
      },
      { "id": "summary", "type": "json", "title": "状态", "path": "/summary" }
    ]
  }
}
